# =============================================================================
# Variables de entorno de Destinos SV
# Copia este archivo a .env.local:   cp .env.example .env.local
# .env.local NO se sube al repositorio (está en .gitignore).
# En Vercel, configúralas en Project Settings → Environment Variables.
# Todas tienen valores por defecto en src/lib/config.ts, así que la app
# funciona aunque no definas ninguna.
# =============================================================================

# Nombre visible de la aplicación (se usa en el navegador: prefijo NEXT_PUBLIC_).
NEXT_PUBLIC_APP_NAME=Destinos SV

# Endpoint de pronóstico de Open-Meteo (API pública, no requiere API key).
# Si contratas el plan comercial, cambia por https://customer-api.open-meteo.com/v1/forecast
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast

# Endpoint de geocodificación de Open-Meteo (buscar ciudades por nombre).
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search

# País (ISO 3166-1 alfa-2) cuyos resultados aparecen primero en el buscador de clima.
DEFAULT_COUNTRY_CODE=SV

# Zona horaria para las fechas del pronóstico.
WEATHER_TIMEZONE=America/El_Salvador
